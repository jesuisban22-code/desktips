{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bureau",
  "version": "0.1.0",
  "identifier": "app.bureau.watcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Bureau",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "label": "main",
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Hs_julyan",
    "copyright": "© 2026 Hs_julyan",
    "category": "DeveloperTool",
    "shortDescription": "Regarde Claude Code travailler, en 3D.",
    "longDescription": "Bureau affiche l'activite de Claude Code comme un atelier isometrique : les agents se deplacent vers le meuble correspondant a l'outil utilise, fouillent, dessinent, et rapportent des dossiers. Il lit les transcriptions deja ecrites sur le disque et ne consomme aucun token.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}