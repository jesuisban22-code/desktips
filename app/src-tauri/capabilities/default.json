{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bureau écoute les événements du moteur et pilote sa propre fenêtre. Sans ce fichier le webview n'a aucune permission : listen() est refusé, aucun événement n'arrive, et la pièce reste vide pour toujours — ce qui est exactement ce qui se passait.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "core:window:allow-request-user-attention",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-current-monitor",
    "core:window:allow-monitor-from-point",
    "core:window:allow-scale-factor",
    "core:window:allow-is-maximized",
    "core:window:allow-is-focused",
    "core:window:allow-maximize",
    "core:window:allow-center",
    "core:app:default",
    "shell:default",
    "autostart:default"
  ]
}
